# Copiez ce fichier en `.env` puis renseignez les valeurs.
# Ne committez jamais votre `.env` (il est ignoré par git).

# Secret utilisé pour signer les jetons d'authentification.
# Générez une longue chaîne aléatoire, par ex. : openssl rand -base64 32
PAYLOAD_SECRET=remplacez-moi-par-une-longue-chaine-aleatoire

# Chaîne de connexion PostgreSQL.
# En local via docker-compose, la base est exposée sur localhost:5432.
DATABASE_URI=postgres://postgres:postgres@localhost:5432/site_vitrine

# URL publique du site (liens absolus, sitemap, aperçus de partage).
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Synchronisation automatique du schéma de base (pratique pour le starter).
# `true` : la base se met à jour au démarrage sans migration manuelle.
# En production réelle, préférez `false` et des migrations versionnées.
DATABASE_PUSH=true

# --- Formulaire de contact (modèle statique) --------------------------------
# URL du serveur d'édition central où le site statique du client envoie son
# formulaire de contact. Vide = même origine (développement).
NEXT_PUBLIC_CONTACT_API=

# Origines autorisées à appeler l'API (CORS), séparées par des virgules.
# En statique, indiquez le domaine du site public du client, ex. :
# https://www.boulangerie-martin.fr,https://boulangerie-martin.fr
PUBLIC_SITE_ORIGINS=

# --- E-mail de notification (optionnel) -------------------------------------
# Sans SMTP renseigné, les e-mails partent en console et les messages sont
# quand même enregistrés. Renseignez pour recevoir une notification.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@exemple.fr
SMTP_FROM_NAME=Site Vitrine
# Destinataire des notifications si l'e-mail de contact n'est pas renseigné.
CONTACT_NOTIFY_EMAIL=

# --- Sauvegardes ------------------------------------------------------------
# Dossier où sont écrites les sauvegardes de la base (défaut : ./backups).
# Nécessite pg_dump / pg_restore (fournis dans l'image Docker).
BACKUP_DIR=
# Mettre à `true` pour désactiver les sauvegardes automatiques planifiées.
DISABLE_BACKUP_SCHEDULER=

# --- Export statique & déploiement ------------------------------------------
# Serveur (qui tourne) à figer par `pnpm export`. Défaut : http://localhost:3000.
EXPORT_SOURCE_URL=
# Dossier de sortie du bundle statique (défaut : out).
EXPORT_OUT_DIR=

# Dépôt du bundle sur l'hébergement mutualisé du client (`pnpm deploy`).
DEPLOY_PROTOCOL=sftp
DEPLOY_HOST=
DEPLOY_PORT=
DEPLOY_USER=
DEPLOY_PASSWORD=
# Clé SSH (chemin) au lieu du mot de passe, pour SFTP. Optionnel.
DEPLOY_PRIVATE_KEY=
# Dossier distant cible (ex. /www, public_html).
DEPLOY_REMOTE_DIR=/
# FTP explicite (FTPS) : mettre `true` pour chiffrer.
DEPLOY_FTP_SECURE=false
